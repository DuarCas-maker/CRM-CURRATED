# See docs/ENVIRONMENT.md for purpose, examples and build/runtime requirements.
# Public Supabase configuration: required at build AND runtime for the web.
# Never put service credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000
# 32 random bytes encoded as base64. Reuse the EXISTING key when deploying.
# Encrypts credentials, applications, archived Gmail payloads and copied Gmail files.
INTEGRATION_ENCRYPTION_KEY=
BOUNCER_API_KEY=
# Legacy general AI key. The three services below do not fall back to it.
# Never prefix secret keys with NEXT_PUBLIC_. Configure securely; do not commit them.
OPENAI_API_KEY=
# Dedicated risk/manual underwriting key. Runtime on BOTH web and worker.
# Required for new analyses; no fallback to the general OPENAI_API_KEY.
R_OPENAI_API_KEY=
# Application field extraction: web runtime only.
A_OPENAI_API_KEY=
# Document type identification: web runtime only.
D_OPENAI_API_KEY=
# Runtime on BOTH web and worker. polling needs OAuth only; pubsub also needs the topic below.
# Omitted/empty defaults to pubsub for compatibility with existing deployments.
GMAIL_SYNC_MODE=polling
# Optional in polling mode; these values are used only with GMAIL_SYNC_MODE=pubsub.
GOOGLE_PUBSUB_TOPIC=projects/PROJECT/topics/gmail-events
GOOGLE_PUBSUB_AUDIENCE=https://crm.example.com/api/gmail/push
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
# Omit pubsubTopic in polling mode. For pubsub it must share the OAuth client's project.
# JSON array for polling: [{"id":"org1","domain":"example.com","clientId":"...","clientSecret":"..."}]
GOOGLE_OAUTH_ORGANIZATIONS=[]
# Enable on web AND worker only after applying migrations 009 onward.
GMAIL_HISTORY_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NOTIFICATION_GMAIL_ACCOUNT_ID=
# Enable only on a local development or isolated demonstration deployment.
DEMO_ENABLED=false
PUBLIC_FORM_ENABLED=false
# Populate only after matching and approving the existing application declarations.
FORM_DECLARATION_VERSION=
FORM_DECLARATION_TEXT=
# Optional locally; Dockerfile.worker sets /tmp/crm-worker-heartbeat automatically.
WORKER_HEARTBEAT_FILE=.local-worker-heartbeat
