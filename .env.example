# See docs/ENVIRONMENT.md for purpose, examples and build/runtime requirements.
# Public Supabase configuration: required at build AND runtime for the web.
# Never put service credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000
# 32 random bytes encoded as base64. Reuse the EXISTING key when deploying.
# Encrypts integration credentials and application data at rest.
INTEGRATION_ENCRYPTION_KEY=
BOUNCER_API_KEY=
GOOGLE_PUBSUB_TOPIC=projects/PROJECT/topics/gmail-events
GOOGLE_PUBSUB_AUDIENCE=https://crm.example.com/api/gmail/push
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
# Each topic must be in the SAME Google Cloud project as its OAuth client.
# JSON array: [{"id":"org1","domain":"example.com","clientId":"...","clientSecret":"...","pubsubTopic":"projects/PROJECT/topics/gmail-events"}]
GOOGLE_OAUTH_ORGANIZATIONS=[]
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NOTIFICATION_GMAIL_ACCOUNT_ID=
# Enable only on a local development or isolated demonstration deployment.
DEMO_ENABLED=false
PUBLIC_FORM_ENABLED=false
# Populate only after matching and approving the existing application declarations.
FORM_DECLARATION_VERSION=
FORM_DECLARATION_TEXT=
# Optional locally; Dockerfile.worker sets /tmp/crm-worker-heartbeat automatically.
WORKER_HEARTBEAT_FILE=.local-worker-heartbeat
