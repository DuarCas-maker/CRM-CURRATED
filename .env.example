# See docs/ENVIRONMENT.md for purpose, examples and build/runtime requirements.
# Public Supabase configuration: required at build AND runtime for the web.
# Never put service credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000
# 32 random bytes encoded as base64. Reuse the EXISTING key when deploying.
# Encrypts credentials, applications, archived Gmail payloads and copied Gmail files.
INTEGRATION_ENCRYPTION_KEY=
BOUNCER_API_KEY=
# Legacy general AI key. The three services below do not fall back to it.
# Never prefix secret keys with NEXT_PUBLIC_. Configure securely; do not commit them.
OPENAI_API_KEY=
# Dedicated risk/manual underwriting key. Runtime on BOTH web and worker.
# Required for new analyses; no fallback to the general OPENAI_API_KEY.
R_OPENAI_API_KEY=
# Application field extraction: web runtime only.
A_OPENAI_API_KEY=
# Document type identification: web runtime only.
D_OPENAI_API_KEY=
# Runtime on BOTH web and worker. polling needs OAuth only; pubsub also needs the topic below.
# Omitted/empty defaults to pubsub for compatibility with existing deployments.
GMAIL_SYNC_MODE=polling
# Optional in polling mode; these values are used only with GMAIL_SYNC_MODE=pubsub.
GOOGLE_PUBSUB_TOPIC=projects/PROJECT/topics/gmail-events
GOOGLE_PUBSUB_AUDIENCE=https://crm.example.com/api/gmail/push
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
# Omit pubsubTopic in polling mode. For pubsub it must share the OAuth client's project.
# JSON array for polling: [{"id":"org1","domain":"example.com","clientId":"...","clientSecret":"..."}]
GOOGLE_OAUTH_ORGANIZATIONS=[]
# Enable on web AND worker only after applying migrations 009 onward.
GMAIL_HISTORY_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NOTIFICATION_GMAIL_ACCOUNT_ID=
# Enable only on a local development or isolated demonstration deployment.
DEMO_ENABLED=false
PUBLIC_FORM_ENABLED=false
# Populate only after matching and approving the existing application declarations.
FORM_DECLARATION_VERSION=
FORM_DECLARATION_TEXT=
# Optional locally; Dockerfile.worker sets /tmp/crm-worker-heartbeat automatically.
WORKER_HEARTBEAT_FILE=.local-worker-heartbeat
# Explicit opt-in control; normal preserves existing operation. Paused does no DB/provider work.
WORKER_EXECUTION_MODE=normal
# Enable only after installing the manual-mail latency SQL delta.
MANUAL_MAIL_FAST_SEND_ENABLED=false
# Required only for pilot; prepare its durable scope privately after installing the reviewed delta.
WORKER_PILOT_ID=
# Keep false on web AND worker until the reviewed R06 SQL and coordinated cutover.
# This gates legacy/global routing. Simple mail below opts in only prepared accounts.
MAIL_TRANSPORT_ROUTING_ENABLED=false
# Coordinated web AND worker runtime flag; keep false until reviewed local SQL is promoted.
# Direct Gmail onboarding, automatic setup and strictly pre-wire Composio fallback.
SIMPLE_MAIL_ENABLED=false
# Composio stays closed independently when releasing Gmail direct first.
SIMPLE_MAIL_COMPOSIO_ENABLED=false
# ID from GOOGLE_OAUTH_ORGANIZATIONS; one admitted paid Google Workspace organization.
# Empty selects the sole configured organization, or the existing "curated" ID.
SIMPLE_MAIL_ORGANIZATION=
# QGR v2 is opt-in after its versioned migration and controlled transition; never enables Composio.
MAIL_QUOTA_POLICY_ENABLED=false
# Server-only C2 verification context JSON; reviewed versions/provenance, no API key inside JSON.
COMPOSIO_MAIL_CONTEXT=
COMPOSIO_API_KEY=
# I04 association UI and explicit four-request checks, independent of runtime activation.
# Keep both false until the new versioned SQL and reviewed included budget are ready.
COMPOSIO_BINDING_V2_ENABLED=false
COMPOSIO_BINDING_CHECKS_ENABLED=false
COMPOSIO_EXISTING_AUTH_CONFIG_ID=
COMPOSIO_CONNECT_ENABLED=false
# Reviewed descriptor + permitted organizations. Never send this JSON to the browser.
COMPOSIO_CONNECT_SETTINGS=
# {"activeKeyId":"key-id","keys":{"key-id":"base64url-32-byte-key"}}; server only.
COMPOSIO_CONNECT_KEYRING=

# Optional Instantly technical webhook: web runtime only, disabled until migration046 and review.
INSTANTLY_WEBHOOK_ENABLED=false
# Two different random 32-byte values encoded as 64 lowercase hex characters. Never NEXT_PUBLIC.
INSTANTLY_S00_WEBHOOK_SECRET=
INSTANTLY_S00_WEBHOOK_DEDUP_KEY=
## Limited verifier administration (web only; disabled until explicitly authorized)
COMPOSIO_VERIFIER_SETUP_ENABLED=false
COMPOSIO_VERIFIER_ACCOUNT_ID=
