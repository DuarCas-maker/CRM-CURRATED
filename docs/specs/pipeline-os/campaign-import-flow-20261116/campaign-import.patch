diff --git a/src/components/pipeline-os/campaign-import-flow.css b/src/components/pipeline-os/campaign-import-flow.css
new file mode 100644
index 0000000..70465ee
--- /dev/null
+++ b/src/components/pipeline-os/campaign-import-flow.css
@@ -0,0 +1,228 @@
+.ci-flow {
+  display: grid;
+  gap: 20px;
+  min-width: 0;
+}
+.ci-heading {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  padding: 8px 0;
+}
+.ci-heading h2 {
+  font-family: "Instrument Serif", serif;
+  font-size: clamp(28px, 4vw, 42px);
+  font-weight: 400;
+  margin: 8px 0;
+}
+.ci-heading p,
+.ci-section-title p {
+  margin: 6px 0;
+  color: var(--pos-muted);
+}
+.ci-eyebrow {
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+  color: var(--pos-accent);
+}
+.ci-heading > svg {
+  color: var(--pos-accent);
+  flex-shrink: 0;
+}
+.ci-steps {
+  list-style: none;
+  display: grid;
+  grid-template-columns: repeat(6, minmax(0, 1fr));
+  padding: 0;
+  margin: 0;
+  border: 1px solid var(--pos-line);
+  border-radius: 12px;
+  overflow: hidden;
+  background: var(--pos-panel);
+}
+.ci-steps li {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 14px 10px;
+  color: var(--pos-muted);
+  font-size: 12px;
+  border-right: 1px solid var(--pos-line);
+}
+.ci-steps li:last-child {
+  border: 0;
+}
+.ci-steps li > span {
+  display: grid;
+  place-items: center;
+  width: 23px;
+  height: 23px;
+  border: 1px solid var(--pos-line2);
+  border-radius: 50%;
+  flex-shrink: 0;
+  font-size: 11px;
+}
+.ci-steps .current {
+  background: var(--pos-soft);
+  color: var(--pos-soft-ink);
+  font-weight: 700;
+}
+.ci-steps .current > span,
+.ci-steps .complete > span {
+  background: var(--pos-accent);
+  color: var(--pos-on-accent);
+  border-color: var(--pos-accent);
+}
+.ci-source-controls {
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr);
+  align-items: end;
+  gap: 18px;
+  margin-top: 20px;
+}
+.ci-source-controls label {
+  display: grid;
+  gap: 6px;
+  font-size: 12px;
+  color: var(--pos-muted);
+}
+.ci-source-controls select {
+  width: 100%;
+  min-width: 0;
+  padding: 10px;
+  border: 1px solid var(--pos-line2);
+  background: var(--pos-panel);
+  color: var(--pos-ink);
+  border-radius: 8px;
+}
+.ci-section-title {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+}
+.ci-status {
+  font-size: 11px;
+  border-radius: 20px;
+  padding: 5px 10px;
+  background: var(--pos-soft);
+  color: var(--pos-soft-ink);
+  white-space: nowrap;
+}
+.ci-metrics {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 12px;
+  margin: 20px 0;
+}
+.ci-metrics > div {
+  background: var(--pos-panel2);
+  border: 1px solid var(--pos-line);
+  border-radius: 10px;
+  padding: 14px;
+  display: grid;
+  gap: 8px;
+}
+.ci-metrics span {
+  font-size: 11px;
+  color: var(--pos-muted);
+}
+.ci-metrics strong {
+  font-size: 25px;
+  font-weight: 600;
+}
+.ci-classification {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+.ci-classification .good {
+  border-color: var(--pos-good-ink);
+  color: var(--pos-good-ink);
+}
+.ci-classification .warn {
+  color: var(--pos-warn-ink);
+}
+.ci-classification .bad {
+  color: var(--pos-bad-ink);
+}
+.ci-confirm {
+  padding: 18px;
+  border: 1px solid var(--pos-warn-ink);
+  background: var(--pos-warn);
+  color: var(--pos-warn-ink);
+  border-radius: 10px;
+}
+.ci-empty {
+  padding: 36px 24px;
+  text-align: center;
+  border: 1px dashed var(--pos-line2);
+  border-radius: 12px;
+  color: var(--pos-muted);
+  max-width: 100%;
+}
+.ci-empty p {
+  max-width: 550px;
+  margin: 8px auto;
+}
+.ci-empty svg {
+  color: var(--pos-accent);
+}
+.ci-refresh {
+  justify-self: start;
+}
+.ci-compose h3 {
+  margin-bottom: 20px;
+}
+.ci-flow .pos-row {
+  flex-wrap: wrap;
+}
+.ci-flow h3 {
+  margin-top: 0;
+}
+.ci-flow .pos-existing {
+  min-width: 0;
+}
+@media (max-width: 800px) {
+  .ci-steps {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+  }
+  .ci-steps li:nth-child(3) {
+    border-right: 0;
+  }
+  .ci-steps li:nth-child(-n + 3) {
+    border-bottom: 1px solid var(--pos-line);
+  }
+  .ci-metrics {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+  .ci-source-controls {
+    grid-template-columns: 1fr;
+  }
+}
+@media (max-width: 440px) {
+  .ci-steps li {
+    padding: 10px 6px;
+    font-size: 10px;
+    gap: 5px;
+  }
+  .ci-steps li > span {
+    width: 20px;
+    height: 20px;
+  }
+  .ci-metrics > div {
+    padding: 10px;
+  }
+  .ci-section-title {
+    align-items: flex-start;
+  }
+  .ci-heading > svg {
+    display: none;
+  }
+  .ci-flow .pos-btn {
+    white-space: normal;
+  }
+  .ci-confirm {
+    padding: 12px;
+  }
+}
diff --git a/src/components/pipeline-os/campaign-import-flow.tsx b/src/components/pipeline-os/campaign-import-flow.tsx
new file mode 100644
index 0000000..29257e9
--- /dev/null
+++ b/src/components/pipeline-os/campaign-import-flow.tsx
@@ -0,0 +1,527 @@
+"use client";
+import { useEffect, useRef, useState } from "react";
+import {
+  ArrowRight,
+  Check,
+  FileSpreadsheet,
+  RefreshCw,
+  ShieldCheck,
+  Upload,
+} from "lucide-react";
+import type { Locale, Workspace } from "@/lib/domain";
+import type { EmailTemplate } from "@/lib/campaign-templates";
+import {
+  campaignImportStatusSchema,
+  campaignImportSteps,
+  importCampaignHref,
+  type CampaignImportStatus,
+} from "@/lib/campaign-import";
+import type { Action } from "../crm";
+import { ImportWizard } from "../import-wizard";
+import { CampaignComposer } from "../campaign-composer";
+import { useProtection } from "../unsaved-changes";
+import { t } from "../ui";
+import "./campaign-import-flow.css";
+
+export function CampaignImportFlow({
+  data,
+  locale,
+  act,
+  refresh,
+  initialTemplate,
+  close,
+}: {
+  data: Workspace;
+  locale: Locale;
+  act: Action;
+  refresh: () => Promise<void>;
+  initialTemplate: EmailTemplate | null;
+  close: () => void;
+}) {
+  const manage = ["superadmin", "seller_admin"].includes(data.profile.role);
+  const [batch, setBatch] = useState("");
+  const [status, setStatus] = useState<CampaignImportStatus | null>(null);
+  const [importing, setImporting] = useState(false),
+    [confirm, setConfirm] = useState(false),
+    [composing, setComposing] = useState(false);
+  const [loading, setLoading] = useState(false),
+    [busy, setBusy] = useState(false),
+    [error, setError] = useState(""),
+    [notice, setNotice] = useState("");
+  const [revision, setRevision] = useState(0);
+  const verifyKeys = useRef(new Map<string, string>());
+  const rootRef = useRef<HTMLElement>(null);
+  useProtection({
+    element: () => rootRef.current,
+    dirty: () => false,
+    busy: () => busy,
+  });
+  useEffect(() => {
+    setStatus(null);
+    setConfirm(false);
+    setComposing(false);
+    setNotice("");
+  }, [batch]);
+  useEffect(() => {
+    if (!batch || data.demo || !manage) return;
+    const controller = new AbortController();
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    async function read() {
+      setLoading(true);
+      setError("");
+      try {
+        const response = await fetch(importCampaignHref(batch), {
+          signal: controller.signal,
+          cache: "no-store",
+        });
+        const result = await response.json();
+        if (!response.ok) throw new Error(result.error);
+        const parsed = campaignImportStatusSchema.parse(result);
+        if (!controller.signal.aborted) {
+          setStatus(parsed);
+          if (
+            ["queued", "running"].includes(parsed.batch.status) ||
+            parsed.counts.running > 0
+          )
+            timer = setTimeout(() => void read(), 5000);
+        }
+      } catch (e) {
+        if (!controller.signal.aborted) setError((e as Error).message);
+      } finally {
+        if (!controller.signal.aborted) setLoading(false);
+      }
+    }
+    void read();
+    return () => {
+      controller.abort();
+      clearTimeout(timer);
+    };
+  }, [batch, data.demo, manage, revision]);
+  const next = status?.next_verification_count || 0;
+  async function verify() {
+    if (!status || !next || busy || data.demo) return;
+    setBusy(true);
+    setError("");
+    setNotice("");
+    const fingerprint = `${batch}:${next}`;
+    let request_key = verifyKeys.current.get(fingerprint);
+    if (!request_key) {
+      request_key = crypto.randomUUID();
+      verifyKeys.current.set(fingerprint, request_key);
+    }
+    try {
+      const response = await fetch("/api/campaigns/import", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          kind: "verify",
+          batch,
+          expected_count: next,
+          request_key,
+        }),
+      });
+      const result = await response.json();
+      if (!response.ok) throw new Error(result.error);
+      verifyKeys.current.delete(fingerprint);
+      setConfirm(false);
+      setRevision((x) => x + 1);
+      setNotice(
+        t(
+          locale,
+          `Verificación aprobada para ${result.queued ?? next} contactos. La campaña sigue sin activar.`,
+          `Verification approved for ${result.queued ?? next} contacts. The campaign is not active.`,
+        ),
+      );
+    } catch (e) {
+      setError((e as Error).message);
+      setConfirm(false);
+      setRevision((x) => x + 1);
+    } finally {
+      setBusy(false);
+    }
+  }
+  const step = composing
+    ? 3
+    : !batch
+      ? 0
+      : status?.batch.status !== "completed"
+        ? 1
+        : 2;
+  if (!manage)
+    return (
+      <p className="pos-info">
+        {t(
+          locale,
+          "La creación de campañas requiere un administrador con MFA.",
+          "Campaign creation requires an administrator with MFA.",
+        )}
+      </p>
+    );
+  return (
+    <section
+      ref={rootRef}
+      className="ci-flow"
+      aria-label={t(
+        locale,
+        "Crear campaña desde un archivo",
+        "Create a campaign from a file",
+      )}
+      aria-busy={busy}
+    >
+      <header className="ci-heading">
+        <div>
+          <span className="ci-eyebrow">
+            {t(
+              locale,
+              "DE TU ARCHIVO A UNA CONVERSACIÓN",
+              "FROM YOUR FILE TO A CONVERSATION",
+            )}
+          </span>
+          <h2>{t(locale, "Crear campaña", "Create campaign")}</h2>
+          <p>
+            {t(
+              locale,
+              "Una base, una audiencia revisada y un envío que tú decides.",
+              "One import, a reviewed audience, and a send you decide.",
+            )}
+          </p>
+        </div>
+        <FileSpreadsheet size={32} />
+      </header>
+      <ol
+        className="ci-steps"
+        aria-label={t(locale, "Etapas de la campaña", "Campaign stages")}
+      >
+        {campaignImportSteps.map(([es, en], i) => (
+          <li
+            key={en}
+            aria-current={i === step ? "step" : undefined}
+            className={i === step ? "current" : i < step ? "complete" : ""}
+          >
+            <span>{i < step ? <Check size={14} /> : i + 1}</span>
+            {t(locale, es, en)}
+          </li>
+        ))}
+      </ol>
+      {data.demo && (
+        <p className="pos-info">
+          {t(
+            locale,
+            "Demostración del recorrido. Las verificaciones, campañas y métricas requieren datos reales y no se ejecutan en demo.",
+            "Workflow demo. Verification, campaigns and metrics require real data and do not run in demo.",
+          )}
+        </p>
+      )}
+      <div className="ci-source pos-card">
+        <div>
+          <h3>
+            {t(
+              locale,
+              "1. Elige la base de contactos",
+              "1. Choose your contact list",
+            )}
+          </h3>
+          <p className="pos-muted">
+            {t(
+              locale,
+              "Reutiliza el importador del CRM: columnas, limpieza, duplicados y errores permanecen en el mismo lote.",
+              "Reuse CRM import: columns, cleanup, duplicates and errors stay in the same batch.",
+            )}
+          </p>
+        </div>
+        <div className="ci-source-controls">
+          <button
+            className="pos-btn pos-primary"
+            disabled={busy}
+            onClick={() => setImporting(true)}
+          >
+            <Upload size={16} />
+            {t(locale, "Cargar Excel / CSV", "Upload Excel / CSV")}
+          </button>
+          <label>
+            {t(
+              locale,
+              "O retoma un archivo importado",
+              "Or resume an imported file",
+            )}
+            <select
+              value={batch}
+              disabled={busy}
+              onChange={(e) => {
+                setBatch(e.target.value);
+                setError("");
+              }}
+            >
+              <option value="">
+                {t(locale, "Selecciona un lote", "Choose an import")}
+              </option>
+              {status &&
+                !data.imports.some((x) => x.id === status.batch.id) && (
+                  <option value={status.batch.id}>{status.batch.name}</option>
+                )}
+              {data.imports.map((b) => (
+                <option key={b.id} value={b.id}>
+                  {b.name}
+                </option>
+              ))}
+            </select>
+          </label>
+        </div>
+      </div>
+      {error && (
+        <p className="pos-alert" role="alert">
+          {error}
+        </p>
+      )}
+      {notice && (
+        <p className="pos-notice" role="status">
+          {notice}
+        </p>
+      )}
+      {loading && !status && (
+        <p role="status">
+          {t(locale, "Consultando el lote…", "Loading import…")}
+        </p>
+      )}
+      {batch && !data.demo && (
+        <button
+          className="pos-btn ci-refresh"
+          disabled={busy || loading}
+          onClick={() => setRevision((x) => x + 1)}
+        >
+          <RefreshCw size={14} />
+          {t(locale, "Actualizar progreso", "Refresh progress")}
+        </button>
+      )}
+      {status && (
+        <>
+          <section className="pos-card ci-review">
+            <div className="ci-section-title">
+              <div>
+                <h3>
+                  {t(locale, "2. Revisión del archivo", "2. File review")}
+                </h3>
+                <p>{status.batch.name}</p>
+              </div>
+              <span className="ci-status">
+                {status.batch.status === "completed"
+                  ? t(locale, "Procesado", "Processed")
+                  : ["queued", "running"].includes(status.batch.status)
+                    ? t(locale, "En procesamiento", "Processing")
+                    : t(locale, "Requiere revisión", "Needs review")}
+              </span>
+            </div>
+            <div className="ci-metrics">
+              {[
+                [
+                  "Filas procesadas",
+                  "Processed rows",
+                  `${status.batch.processed} / ${status.batch.total}`,
+                ],
+                [
+                  "Contactos únicos",
+                  "Unique contacts",
+                  status.counts.unique_contacts,
+                ],
+                ["Duplicados", "Duplicates", status.batch.duplicates],
+                [
+                  "Errores de importación",
+                  "Import errors",
+                  status.batch.errors,
+                ],
+              ].map(([es, en, n]) => (
+                <div key={es}>
+                  <span>{t(locale, String(es), String(en))}</span>
+                  <strong>{n}</strong>
+                </div>
+              ))}
+            </div>
+          </section>
+          <section className="pos-card ci-verification">
+            <div className="ci-section-title">
+              <div>
+                <h3>
+                  {t(
+                    locale,
+                    "3. Aprobación y clasificación con Bouncer",
+                    "3. Approval and classification with Bouncer",
+                  )}
+                </h3>
+                <p>
+                  {t(
+                    locale,
+                    "Los válidos previos se reutilizan. Los dudosos, inválidos, bajas y errores no se enviarán.",
+                    "Previously valid contacts are reused. Uncertain, invalid, suppressed and errored contacts will not be sent.",
+                  )}
+                </p>
+              </div>
+              <ShieldCheck size={24} />
+            </div>
+            <div className="ci-metrics ci-classification">
+              {[
+                ["Válidos", "Valid", status.counts.valid, "good"],
+                ["Dudosos", "Uncertain", status.counts.uncertain, "warn"],
+                ["Inválidos", "Invalid", status.counts.invalid, "bad"],
