+revoke all on function public.campaign_create_from_import(jsonb,uuid) from service_role;
+notify pgrst,'reload schema';
+commit;
diff --git a/docs/specs/pipeline-os/campaign-import-flow-20261116/migrations/up.sql b/docs/specs/pipeline-os/campaign-import-flow-20261116/migrations/up.sql
