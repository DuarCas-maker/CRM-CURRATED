+import { z } from "zod";
+
+const count = z.number().int().nonnegative();
+export const campaignImportStatusSchema = z.object({
+  batch: z.object({
+    id: z.uuid(),
+    name: z.string(),
+    status: z.string(),
+    total: count,
+    processed: count,
+    imported: count,
+    duplicates: count,
+    errors: count,
+  }),
+  counts: z.object({
+    unique_contacts: count,
+    valid: count,
+    invalid: count,
+    uncertain: count,
+    pending: count,
+    running: count,
+    attention: count,
+    excluded: count,
+  }),
+  next_verification_count: count.max(5000),
+  ready: z.boolean(),
+});
+export type CampaignImportStatus = z.infer<typeof campaignImportStatusSchema>;
+export const campaignImportSteps = [
+  ["Archivo", "File"],
+  ["Revisión", "Review"],
+  ["Bouncer", "Bouncer"],
+  ["Plantilla", "Template"],
+  ["Envío", "Sending"],
+  ["Respuestas", "Replies"],
+] as const;
+export const campaignImportErrors: Record<string, [string, string]> = {
+  CI_FORBIDDEN: [
+    "Se requiere un administrador con MFA.",
+    "An administrator with MFA is required.",
+  ],
+  CI_BATCH_NOT_FOUND: [
+    "El lote no está disponible.",
+    "Import batch unavailable.",
+  ],
+  CI_IMPORT_RUNNING: [
+    "La importación todavía se está procesando.",
+    "The import is still processing.",
+  ],
+  CI_STALE: [
+    "La cantidad pendiente cambió. Actualiza y vuelve a revisar antes de confirmar.",
+    "The pending count changed. Refresh and review before confirming.",
+  ],
+  CI_VERIFICATION_PENDING: [
+    "Termina la revisión y verificación del lote antes de crear la campaña.",
+    "Finish reviewing and verifying this import before creating the campaign.",
+  ],
+  CI_SELECTION_SCOPE: [
+    "Selecciona solo destinatarios elegibles de este archivo.",
+    "Select eligible recipients from this file only.",
+  ],
+  CI_SELECTION_LIMIT: [
+    "El límite es de 5.000 destinatarios por campaña. Elige una selección; no se recortó el lote.",
+    "The campaign limit is 5,000 recipients. Make a selection; the import was not truncated.",
+  ],
+  CI_TEMPLATE_CHANGED: [
+    "La plantilla cambió. Vuelve a seleccionarla.",
+    "The template changed. Select it again.",
+  ],
+  CI_UNAVAILABLE: [
+    "El recorrido de campañas por archivo todavía no está disponible. No se usará una audiencia global.",
+    "Import campaigns are unavailable. A global audience will not be used.",
+  ],
+};
+export function importCampaignHref(
+  batch: string,
+  template?: string,
+  account?: string,
+  search = "",
+  page = 0,
+) {
+  z.uuid().parse(batch);
+  const q = new URLSearchParams({ batch });
+  if (template && account) {
+    q.set("mode", "leads");
+    q.set("template", z.uuid().parse(template));
+    q.set("account", z.uuid().parse(account));
+    q.set("search", search);
+    q.set("page", String(page));
+  }
+  return "/api/campaigns/import?" + q;
+}
diff --git a/src/lib/server/campaign-import.ts b/src/lib/server/campaign-import.ts
new file mode 100644
index 0000000..2354bdf
--- /dev/null
+++ b/src/lib/server/campaign-import.ts
@@ -0,0 +1,145 @@
+import { z } from "zod";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { campaignTemplateSchema } from "../campaign-templates";
+import { campaignImportErrors } from "../campaign-import";
+import { brandPreparationSchema } from "../brand-delivery";
+import {
+  deliveryContext,
+  deliveryJsonError,
+  deliveryResult,
+} from "./brand-delivery";
+import { HttpError } from "./supabase";
+
+export type ImportCampaignContext = {
+  db: SupabaseClient;
+  profile: { role: string };
+};
+function administrator(ctx: ImportCampaignContext) {
+  if (!["superadmin", "seller_admin"].includes(ctx.profile.role))
+    throw new HttpError(403, campaignImportErrors.CI_FORBIDDEN[0]);
+}
+export function importCampaignError(error: unknown) {
+  if (error instanceof SyntaxError)
+    return Response.json(
+      { error: "JSON inválido. / Invalid JSON." },
+      { status: 400 },
+    );
+  if (error instanceof z.ZodError)
+    return Response.json(
+      { error: "Revisa los campos del formulario. / Check the form fields." },
+      { status: 400 },
+    );
+  return deliveryJsonError(error);
+}
+async function rpc(
+  ctx: ImportCampaignContext,
+  name: string,
+  args: Record<string, unknown>,
+) {
+  const { data, error } = await ctx.db.rpc(name, args);
+  if (!error) return data;
+  if (["PGRST202", "42883"].includes(error.code || ""))
+    throw new HttpError(503, campaignImportErrors.CI_UNAVAILABLE[0]);
+  if (error.message in campaignImportErrors)
+    throw new HttpError(
+      error.message === "CI_FORBIDDEN"
+        ? 403
+        : error.message === "CI_BATCH_NOT_FOUND"
+          ? 404
+          : 409,
+      campaignImportErrors[error.message][0],
+    );
+  return deliveryResult({ data, error });
+}
+export async function readImportCampaign(url: URL, ctx: ImportCampaignContext) {
+  administrator(ctx);
+  const p = url.searchParams;
+  const batch = z.uuid().parse(p.get("batch"));
+  const mode = z.enum(["status", "leads"]).parse(p.get("mode") || "status");
+  return mode === "status"
+    ? rpc(ctx, "campaign_import_status", { batch })
+    : rpc(ctx, "campaign_import_leads_page", {
+        batch,
+        template: z.uuid().parse(p.get("template")),
+        account: z.uuid().parse(p.get("account")),
+        search_text: z
+          .string()
+          .max(200)
+          .parse(p.get("search") || ""),
+        page_number: z.coerce
+          .number()
+          .int()
+          .min(0)
+          .max(1000000)
+          .parse(p.get("page") || 0),
+      });
+}
+export async function writeImportCampaign(
+  body: unknown,
+  ctx: ImportCampaignContext,
+) {
+  administrator(ctx);
+  const envelope = z
+    .discriminatedUnion("kind", [
+      z
+        .object({
+          kind: z.literal("verify"),
+          batch: z.uuid(),
+          expected_count: z.number().int().min(1).max(5000),
+          request_key: z.uuid(),
+        })
+        .strict(),
+      z
+        .object({
+          kind: z.literal("create"),
+          request_key: z.uuid(),
+          payload: z.record(z.string(), z.unknown()),
+        })
+        .strict(),
+    ])
+    .parse(body);
+  if (envelope.kind === "verify") {
+    if (!process.env.BOUNCER_API_KEY)
+      throw new HttpError(
+        503,
+        "Bouncer no está configurado. / Bouncer is not configured.",
+      );
+    return rpc(ctx, "campaign_verify_import", {
+      batch: envelope.batch,
+      expected_count: envelope.expected_count,
+      request_key: envelope.request_key,
+    });
+  }
+  const p = envelope.payload;
+  const config = z
+    .object({
+      import_batch_id: z.uuid(),
+      account_id: z.uuid(),
+      seller_id: z.uuid(),
+      template_id: z.uuid(),
+      template_version: z.coerce.number().int().positive(),
+      daily_limit: z.coerce.number().int().min(1).max(2000),
+      timezone: z.string().min(1).max(80),
+      start_hour: z.coerce.number().int().min(0).max(23),
+      end_hour: z.coerce.number().int().min(1).max(24),
+      selected_contact_ids: z.array(z.uuid()).max(5000).optional(),
+      brand_preparation: brandPreparationSchema,
+    })
+    .parse(p);
+  if (config.start_hour >= config.end_hour)
+    throw new HttpError(
+      400,
+      "Revisa el horario de envío. / Check the sending hours.",
+    );
+  const content = campaignTemplateSchema.parse(p);
+  await deliveryContext(
+    ctx.db,
+    config.account_id,
+    config.brand_preparation,
+    "campaign",
+  );
+  return rpc(ctx, "campaign_create_from_import", {
+    p: { ...config, ...content, steps: [] },
+    request_key: envelope.request_key,
+  });
+}
