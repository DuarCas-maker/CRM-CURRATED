 if(u.pathname==='/qa/stats')return json(res,200,counts);if(u.pathname==='/qa/fail-read'){failRead=true;return json(res,200,{});}
 if(u.pathname==='/qa/workspace'){const workspace=await serialized(async()=>{await f.asUser(f.users.admin);const accounts=(await db.query<any>('select id,email,status from mail_accounts order by created_at,id')).rows;const caps=(await db.query<any>('select brand_sender_capabilities() cap')).rows.map(r=>r.cap);return {demo:false,crm_extensions_ready:true,profile:{id:f.users.admin,name:'Operador de ejemplo',role:'superadmin'},profiles:[{id:f.users.seller,name:'Responsable de ejemplo',role:'seller',active:true},{id:f.users.admin,name:'Operador de ejemplo',role:'superadmin',active:true}],accounts:accounts.map(a=>({...a,brand_context:caps.find(c=>c.account_id===a.id)})),sender_account_ids:f.accounts,imports:(await db.query('select id,name,status,total,processed,imported,duplicates,errors,created_at from import_batches order by created_at')).rows,email_templates:(await db.query('select * from email_templates')).rows,campaigns:[],campaign_assets:[]};});return json(res,200,workspace);}
 if(u.pathname==='/api/campaigns/control'){
  if(req.method==='GET'){counts.reads++;if(failRead){failRead=false;return json(res,503,{error:'Ensayo: consulta temporalmente no disponible.'});}try{return json(res,200,await readControl(u,ctx));}catch(e){const r=controlError(e);return json(res,r.status,await r.json());}}
  const p=JSON.parse((await bytes(req)).toString());counts.mutations[p.kind]=(counts.mutations[p.kind]||0)+1;try{return json(res,200,await writeControl(p,ctx));}catch(e){const r=controlError(e);return json(res,r.status,await r.json());}
 }
 if(u.pathname==='/api/campaigns/import'){try{return json(res,200,await readImportCampaign(u,ctx));}catch(e){const r=importCampaignError(e);return json(res,r.status,await r.json());}}
 if(u.pathname.startsWith('/api/'))return json(res,501,{error:'Fixture: operation not enabled'});
